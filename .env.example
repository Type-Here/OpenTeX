# MongoDB (Docker Compose)
MONGO_ROOT_USER=opentex_admin
MONGO_ROOT_PASSWORD=change_me_in_production
MONGO_DB=opentex_db
MONGO_PORT=27017

# Backend FastAPI
BACKEND_PORT=8000
SECRET_KEY=insecure_secret_key_replace_me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
DEBUG=true

# Standalone scripts (seed, schema validation) — direct connection to MongoDB
# Credentials must match MONGO_ROOT_USER / MONGO_ROOT_PASSWORD above.
# On Linux, if localhost:27017 is unreachable (Docker port-mapping issue), replace
# localhost with the container IP: docker inspect opentex-mongo --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}'
MONGODB_URI="mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@localhost:27017/?authSource=admin"
OPENTEX_DB_NAME="${MONGO_DB}"
